# Resource Broker — example environment file.
#
# Copy to .env (gitignored) and fill in real values for your deployment, or
# set these as systemd Environment= lines (see deploy/broker.service).
# Every var here defaults to loopback/localhost when unset — nothing in this
# repo ever needs a real LAN address baked in. Full reference, including
# every var not shown here, is in README.md's "Configuration (env)" table.

# --- Upstream ---------------------------------------------------------------
# Which upstream API family the Broker fronts: "ollama" (default) or "openai"
# (any OpenAI-compatible server, e.g. vLLM).
UPSTREAM_BACKEND=ollama

# Upstream Ollama base URL. Required/validated only when UPSTREAM_BACKEND=ollama.
OLLAMA_URL=http://127.0.0.1:11434

# Upstream OpenAI-compatible server base URL (e.g. a vLLM instance on your own
# box or LAN). Required only when UPSTREAM_BACKEND=openai. Replace the host
# below with wherever you actually run it — never commit a real LAN address.
#UPSTREAM_URL=http://127.0.0.1:8000
#UPSTREAM_API_KEY=

# --- Listener ports (defaults shown) ----------------------------------------
BROKER_INTERACTIVE_ADDR=:11435
BROKER_BATCH_ADDR=:11436
BROKER_CONTROL_ADDR=:11437
#BROKER_EMBED_ADDR=:11438

# --- Control plane auth (ADR-0005) ------------------------------------------
# Empty (default): POST /control is accepted from loopback only. Set this to
# require a Bearer token from every caller instead. Generate your own value;
# never reuse an example.
#BROKER_CONTROL_TOKEN=

# --- Optional integrations ---------------------------------------------------
# Local Plex Media Server, used only to corroborate a "Plex Transcoder"
# process match against a real playback session.
#PLEX_URL=http://localhost:32400
#PLEX_TOKEN=

# Upstream Infinity image-embedding server. Unset disables the embed lane.
#INFINITY_URL=http://127.0.0.1:7997

# Tdarr server, for cooperative GPU worker management. Unset disables it.
#BROKER_TDARR_URL=http://localhost:8265
#BROKER_TDARR_NODE_ID=
